# MongoDB local example
MONGODB_URI=mongodb://127.0.0.1:27017/travel_system_db

# Use a long random value in production.
JWT_SECRET=replace-with-a-strong-random-64-character-secret
JWT_COOKIE_NAME=travel_admin_token

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TINYMCE_API_KEY=no-api-key

# Required on Vercel for durable media uploads (Storage -> Blob)
# Keep empty for local development with filesystem uploads.
BLOB_READ_WRITE_TOKEN=

# First admin created by npm run seed
SEED_ADMIN_EMAIL=admin@travel.local
SEED_ADMIN_PASSWORD=Admin@12345

# SMTP configuration for contact/booking/newsletter notifications
# Use SMTP_PASS (preferred). SMTP_PASSWORD is also supported.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=
FROM_EMAIL=
