# MongoDB local example
MONGODB_URI=mongodb://127.0.0.1:27017/travel_system_db

# Use a long random value in production.
JWT_SECRET=replace-with-a-strong-random-64-character-secret
JWT_COOKIE_NAME=travel_admin_token

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TINYMCE_API_KEY=no-api-key

# First admin created by npm run seed
SEED_ADMIN_EMAIL=admin@travel.local
SEED_ADMIN_PASSWORD=Admin@12345
